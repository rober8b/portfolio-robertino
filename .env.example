# GitHub Personal Access Token (read-only, public_repo + read:user scopes)
# Create at: https://github.com/settings/tokens (fine-grained, read-only)
# Local: copy this file to .env.local and fill in.
# Vercel: add as project env var (Production + Preview + Development).
GITHUB_TOKEN=

# Secret to authorize manual cache invalidation of /api/revalidate-github.
# Generate with: openssl rand -hex 32
# Vercel: add to Production + Preview + Development.
REVALIDATE_SECRET=
